# ── Provider LLM (qualquer endpoint compatível com OpenAI) ──────────────
# DeepSeek (barato; off-peak = fora de 01–04h e 06–10h UTC, metade do preço)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=deepseek-chat

# Alternativas:
#   OpenAI:  LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4.1-mini
#   Anthropic via proxy compatível / Groq / Gemini — só trocar BASE_URL+KEY+MODEL.

# Modo mock roda o grafo inteiro sem nenhuma chave (útil p/ CI e demo):
#   python -m fabrica.cli run --mock
